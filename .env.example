# Copy this file to .env and fill in real values. Never commit .env itself.

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=guardrail_docs

# --- Ollama ---
# Default assumes the ollama service in docker-compose.yml.
# IdeaPad Slim 5i user: point this at the reference machine's
# LAN IP (e.g. http://192.168.1.23:11434) or an ngrok URL from
# a Colab GPU session instead.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Database (audit log + users) ---
DATABASE_URL=sqlite:///./data/guardrail.db

# --- API ---
API_BASE_URL=http://api:8000
